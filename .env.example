# Node 24+ required. Copy to .env; never commit real credentials.
PORT=3001
DATABASE_PATH=./data/samp.sqlite
# Set to the exact public HTTPS origin for production, without a path.
# APP_ORIGIN=https://your-samp-domain.example
# Generate privately with npm run admin:setup. Never use a VITE_ prefix.
# ADMIN_TOKEN=

# Set to smtp after adding a Gmail App Password securely. Disabled by default.
EMAIL_TRANSPORT=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bil332204@gmail.com
# Google Account -> Security -> 2-Step Verification -> App passwords.
# Use an App Password, not your normal Google password.
# SMTP_PASSWORD=
MAIL_FROM=SAMP <bil332204@gmail.com>
INQUIRY_TO=contact@sampventure.com

# Optional alternative: EMAIL_TRANSPORT=resend, with a verified sender.
# RESEND_API_KEY=
# MAIL_FROM=SAMP <website@your-verified-domain.example>

# Set only to the exact number of trusted reverse proxy hops.
TRUST_PROXY_HOPS=0
